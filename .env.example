# Von https://my.telegram.org -> "API development tools"
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Standard-Anbieter. Weitere Anbieter (OpenAI, Google, lokal mit Ollama, ...)
# kannst du im Webinterface unter "Anbieter" hinzufügen.
LLM_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api/v1

# Zugang zum Webinterface (Basic Auth) - unbedingt ändern!
WEB_USER=admin
WEB_PASSWORD=bitte-aendern

# Nur ohne Docker (in Docker werden diese Werte ignoriert, gespeichert wird immer in /data):
# DATA_DIR=./data
# HOST=127.0.0.1
# PORT=8080

# Benachrichtigungen (optional)
# Ohne Angabe landen sie in deinen "Gespeicherten Nachrichten" (ohne Push).
# Für Push: bei @BotFather einen Bot anlegen, Token hier eintragen, den Bot
# einmal öffnen und "Start" drücken.
# NOTIFY_BOT_TOKEN=123456:ABC-DEF...
# NOTIFY_CHAT_ID=          (leer = an deinen eigenen Account)
# Adresse des Webinterfaces, damit Benachrichtigungen einen Link enthalten
# PUBLIC_URL=http://raspberrypi:8080

# Whisper-Spracherkennung beim Standard-Anbieter über einen anderen Endpunkt (optional,
# alternativ im Webinterface einen Anbieter wie Groq oder OpenAI anlegen)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=gsk_...
